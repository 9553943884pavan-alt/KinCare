{
  "name": "kincare-ai-elderly-care-platform",
  "version": "1.0.0",
  "description": "Smart, interconnected AI healthcare & medication management platform for elderly individuals, caretakers, and family members. Built with Google Gemini AI and Cloud Run.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "lint": "node --check server/index.js && node --check server/app.js && node --check server/data/store.js && node --check server/data/seedData.js && node --check server/security/passcodeAuth.js"
  },
  "keywords": [
    "elderly-care",
    "medication-management",
    "healthcare",
    "google-gemini",
    "cloud-run",
    "accessibility",
    "promptwars"
  ],
  "author": "Pavan",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
