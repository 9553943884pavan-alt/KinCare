# Server Configuration (Cloud Run & Render default to 8080)
PORT=8080
NODE_ENV=development

# Security & Session Configuration
# Generate a strong production secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set true in production to reject startup if SESSION_SECRET is missing or weak
ENFORCE_SESSION_SECRET=false
# Explicitly controls 1-tap demo sign-in & demo PIN shortcuts (defaults to false in production, true in development)
DEMO_MODE=true

# Persistent Database Configuration
# Local / Render Disk SQLite (WAL mode) path; defaults to server/data/kincare.sqlite
SQLITE_DB_PATH=
# Optional PostgreSQL URL for multi-instance Cloud Run / Render deployments (run: npm install pg)
DATABASE_URL=

# Google Gemini AI Configuration (Official @google/genai SDK)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Proactive Email Reminder Engine (Resend / SMTP / Hybrid Outbox)
# Option 1: Resend API Key (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_RECIPIENT=9553943884pavan@gmail.com

# Option 2: Standard SMTP (e.g. Gmail App Password, Brevo, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KinCare AI <onboarding@resend.dev>"
